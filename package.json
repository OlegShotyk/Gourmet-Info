  "description": "Гурман-Інфо — ЛР №7: адаптивний лендинг на Tailwind CSS з медіаінтеграціями",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o css/tailwind.css --minify",
